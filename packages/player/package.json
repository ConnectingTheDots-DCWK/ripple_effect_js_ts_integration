{
  "name": "@ripplefx/player",
  "version": "1.5.0",
  "description": "Play Ripple Effect campaigns in a browser or in Node: the engine as a WebAssembly component, and a TypeScript API over it.",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://github.com/ConnectingTheDots-DCWK/ripple_effect_js_ts_integration/tree/main/packages/player#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ConnectingTheDots-DCWK/ripple_effect_js_ts_integration.git",
    "directory": "packages/player"
  },
  "bugs": "https://github.com/ConnectingTheDots-DCWK/ripple_effect_js_ts_integration/issues",
  "keywords": [
    "ripple-effect",
    "interactive-fiction",
    "narrative",
    "webassembly",
    "wasm"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "generated",
    "LICENSE",
    "ENGINE-NOTICE",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "generate": "node scripts/transpile.ts",
    "build": "pnpm generate && tsc -p tsconfig.build.json",
    "typecheck": "pnpm generate && tsc -p tsconfig.json",
    "test": "pnpm generate && vitest run",
    "prepack": "pnpm build",
    "browsers": "pnpm build && node test/browser/run.ts"
  },
  "dependencies": {
    "@bytecodealliance/preview2-shim": "0.28.0"
  },
  "devDependencies": {
    "@bytecodealliance/jco": "1.37.0",
    "playwright": "1.63.0",
    "vite": "8.3.4"
  }
}
